{
  "folders": [
    {
      "name": "TenderProof Core",
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "files.exclude": {
      "**/.git": true,
      "**/.venv": true,
      "**/node_modules": true,
      "**/__pycache__": true,
      "**/.pytest_cache": true,
      "**/.ruff_cache": true,
      "**/runtime": true,
      "**/tmp": true,
      "**/dist": true,
      "**/coverage": true,
      "**/htmlcov": true,
      "**/test-results": true,
      "**/playwright-report": true
    }
  }
}