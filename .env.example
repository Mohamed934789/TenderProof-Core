# Only AI mode uses these values. Keep the real key in your local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Explicit opt-in. Starting the app never submits an AI request.
TENDERPROOF_ALLOW_PAID_API=0
TENDERPROOF_SINGLE_AI_RUN=1
TENDERPROOF_DEMO_DIR=./demo
TENDERPROOF_MLFLOW_ENABLED=0
# Optional; default SQLite lives under runtime/mlflow (Docker: runtime/docker/api/mlflow).
# MLFLOW_TRACKING_URI=sqlite:///D:/TenderProof-Integration/runtime/mlflow/mlflow.db
